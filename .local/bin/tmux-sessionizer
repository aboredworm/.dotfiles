#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)); then
  echo "Usage: tmux-sessionizer [project-directory]" >&2
  exit 2
fi

if (($# == 1)); then
  selected="$1"
else
  command -v fzf >/dev/null 2>&1 || { echo "tmux-sessionizer needs fzf" >&2; exit 1; }
  roots=("$HOME/projects" "$HOME/work/dev")
  projects=()
  for root in "${roots[@]}"; do
    [[ -d "$root" ]] && projects+=("$root")
  done
  ((${#projects[@]})) || { echo "No project directories found" >&2; exit 1; }
  selected="$(find "${projects[@]}" -mindepth 1 -maxdepth 2 -type d -print | sort | fzf)" || exit 0
fi

[[ -n "$selected" ]] || exit 0
[[ -d "$selected" ]] || { echo "Not a directory: $selected" >&2; exit 1; }

name="$(basename "$selected" | tr -cs '[:alnum:]_-' '_')"
if ! tmux has-session -t "$name" 2>/dev/null; then
  tmux new-session -d -s "$name" -c "$selected"
fi

if [[ -n "${TMUX:-}" ]]; then
  tmux switch-client -t "$name"
else
  tmux attach-session -t "$name"
fi
