#!/usr/bin/env bash

exec nvim \
    -c 'lua require("lazy").load({plugins={"telescope.nvim"}})' \
    -c 'Telescope find_files' \
    -c 'lua vim.schedule(function() local state=require("telescope.state"); local prompt_bufnr=state.get_existing_prompt_bufnrs()[1]; if prompt_bufnr then vim.api.nvim_set_current_win(state.get_status(prompt_bufnr).prompt_win) end end)'
